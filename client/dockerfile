FROM node:16-alpine

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm install --legacy-peer-deps

COPY . .

RUN npm install @mui/x-date-pickers

RUN npm install date-fns

RUN npm install @emotion/react @emotion/styled

RUN npm install @mui/material

RUN npm run build

EXPOSE 3000

CMD ["npm", "start"]
